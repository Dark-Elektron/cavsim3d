   "source": [
    "print(rom._concatenated.n_total_ports)\n",
    "print(rom._concatenated._internal_ports)\n",
    "print(rom._concatenated._external_ports)\n",
    "print(rom._concatenated._global_to_local)\n",
    "print(rom._concatenated.connections)"
   ]
  },
